CD80_DB_PATH=data/cd80.sqlite3
# Run scripts/init_config.py to create a local .env with a random admin key.
CD80_ADMIN_API_KEY=
# Optional protection for direct read access; the website proxy forwards this key.
CD80_READ_API_KEY=
CD80_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CD80_DATA_API_URL=http://127.0.0.1:8895
# Existing website user IDs permitted to modify shared competition data.
CD80_DATA_ADMIN_USERS=

