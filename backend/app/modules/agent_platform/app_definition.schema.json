{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd80.local/contracts/cd80.app-2.schema.json",
  "title": "cd80.app/2 portable application definition",
  "description": "Canonical saved App definition. ZIP codeFile/resourceFiles and Python APP_INTERFACE are import transports and do not appear in saved definitions. Static issues may still require repair and verification before enablement.",
  "type": "object",
  "required": ["format", "name", "inputSchema", "nodes", "outputs"],
  "properties": {
    "format": {"const": "cd80.app/2"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string"},
    "inputSchema": {"$ref": "#/$defs/jsonSchema"},
    "testCases": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/testCase"}, "description": "Saved original task case first, followed by optional additional cases. A null expectation means an independent expected result is still required before verification."},
    "rules": {"type": "array", "items": {"type": "string", "maxLength": 4000}},
    "nodes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/node"}},
    "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/binding"}},
    "gaps": {"type": "array"},
    "parameterization": {"type": "array"},
    "source": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "testCase": {
      "type": "object",
      "required": ["label", "input", "fileBindings", "expectation"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "input": {"type": "object"},
        "fileBindings": {"type": "object", "additionalProperties": {"type": "string"}},
        "expectation": {"oneOf": [
          {"type": "null"},
          {"type": "object", "required": ["mode", "value"], "properties": {"mode": {"const": "json_equals"}, "value": {}}, "additionalProperties": false},
          {"type": "object", "required": ["mode", "values"], "properties": {"mode": {"const": "fields"}, "values": {"type": "object", "minProperties": 1}}, "additionalProperties": false}
        ]}
      },
      "additionalProperties": false
    },
    "jsonSchema": {
      "type": "object",
      "description": "JSON Schema 2020-12 object; the runtime checks validity and rejects external or recursive $ref/$dynamicRef."
    },
    "binding": {
      "type": "object",
      "required": ["from"],
      "properties": {
        "from": {"enum": ["input", "literal", "step", "file", "artifact"]},
        "path": {"type": "string"},
        "stepId": {"type": "string"},
        "value": {},
        "name": {"type": "string"},
        "input": {"type": "string"}
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "base64": {"type": "string", "contentEncoding": "base64"}
      },
      "oneOf": [{"required": ["text"], "not": {"required": ["base64"]}}, {"required": ["base64"], "not": {"required": ["text"]}}],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "schema": {"$ref": "#/$defs/jsonSchema"},
        "files": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "mediaType": {"type": "string"}}, "additionalProperties": false}]}},
        "evidenceFields": {"type": "array", "items": {"type": "string"}},
        "requiredTools": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
        "kind": {"enum": ["code", "tool", "skill"]},
        "title": {"type": "string"},
        "task": {"type": "string", "description": "Skill step task passed to the frozen Skill runner."},
        "code": {"type": "string"},
        "files": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/resource"}},
        "component": {"type": "object", "description": "Closed component snapshot validated by cd80.capability/1 snapshot contract."},
        "componentRef": {"type": "object", "required": ["assetId", "versionId"], "properties": {"assetId": {"type": "string"}, "versionId": {"type": "string"}}, "additionalProperties": false},
        "inputBindings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/binding"}},
        "delivery": {"$ref": "#/$defs/delivery"},
        "checkpoint": {"type": "boolean"},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
