# 复制为 .env 后按需要修改；这些路径相对于本网站目录，不受启动时工作目录影响。
PORT=8893
GITEE_AI_BASE_URL=https://ai.gitee.com/v1
GITEE_AI_MODEL=GLM-5.3
# 只填写在后端的 .env 中，不能放入前端或公开仓库。
GITEE_AI_API_KEY=replace_with_your_token
# 仅在本机首次建立账号时，是否接续唯一一份尚未归属的旧历史记录。
IMPORT_LEGACY_HISTORY=0
DATA_DIR=data
FRONTEND_DIST=frontend/dist
# sub-agent 使用隔离的 WASI CPython；先执行 scripts/setup_agent_runtime.py 安装。
AGENT_RUNTIME_DIR=data/agent-runtime
AGENT_EXECUTION_TIMEOUT=15
AGENT_MEMORY_MB=128
AGENT_MODEL_MAX_TOKENS=8192
AGENT_MODEL_REASONING_EFFORT=low

# Explore 单次运行上限；默认10分钟，其中最多200秒留给写作与复核。
EXPLORE_RUN_TIMEOUT_SECONDS=600
# 整轮最多重试一次瞬态模型请求，仍受总时限和工具预算约束。
# 仅在本机DNS返回代理保留地址时，显式改为cloudflare_doh；不放宽SSRF/TLS。
EXPLORE_PUBLIC_DNS_MODE=system
# 可按实体词明确授权公开官网入口；运行时冻结清单，正文链接可继续读取。
# 格式：[{"keywords":["机构名称"],"urls":["https://official.example/"]}]
EXPLORE_PUBLIC_ENTRY_CATALOG=[]

# 产品运行时 Skill 目录：每个子目录包含 SKILL.md；允许为空，不影响工具。
SKILLS_DIR=skills
# 南方财经数据凭据，仅放后端。未配置时相关工具显示不可用。
SFC_TOKEN=
# 可选：显式指定凭据文件，与 SFC_TOKEN 二选一；不自动读取其他应用的配置。
SFC_KEY_FILE=
SFC_REQUEST_TIMEOUT=20

# 本机 SQLite 金融数据服务。密钥只放后端环境，不放浏览器。
CD80_DATA_API_URL=http://127.0.0.1:8897
CD80_ADMIN_API_KEY=
CD80_READ_API_KEY=
# 允许写入的本地用户 ID，逗号分隔；留空则仅能读取。
CD80_DATA_ADMIN_USERS=
